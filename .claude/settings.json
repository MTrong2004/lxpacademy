{
  "$comment": [
    "Bớt hỏi quyền cho các lệnh chỉ đọc / build lại — mỗi lần hỏi là một vòng chờ.",
    "deny: chặn cứng việc sửa build output (app.js, admin.js, dist/) để không phá quy tắc",
    "số 1 trong CLAUDE.md, và chặn đọc .env để secret không bị đưa vào ngữ cảnh chat.",
    "npm run migrate KHÔNG nằm trong allow — nó đổi DB nên vẫn phải hỏi từng lần."
  ],
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run map)",
      "Bash(npm run find:*)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run check:catch)",
      "Bash(node scripts/find-symbol.js:*)",
      "Bash(node scripts/map.js)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "PowerShell(npm run build)",
      "PowerShell(npm run map)",
      "PowerShell(npm run find:*)",
      "PowerShell(npm run format)",
      "PowerShell(npm run format:check)",
      "PowerShell(npm run check:catch)",
      "PowerShell(node scripts/find-symbol.js:*)",
      "PowerShell(node scripts/map.js)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)",
      "PowerShell(git branch:*)"
    ],
    "deny": [
      "Edit(./app.js)",
      "Edit(./admin.js)",
      "Edit(./dist/**)",
      "Edit(./version.json)",
      "Edit(./docs/BLOCK_MAP.md)",
      "Write(./app.js)",
      "Write(./admin.js)",
      "Write(./dist/**)",
      "Write(./version.json)",
      "Write(./docs/BLOCK_MAP.md)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.vercel)"
    ]
  }
}
